# Copy to .env.local for local overrides. Both are optional locally.

# Postgres connection string (Neon in production). When unset, the app uses an
# embedded PGlite database stored in ./.data/pglite — no setup required.
DATABASE_URL=

# Secret used to HMAC-sign session cookies. Required in production (Vercel).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=
